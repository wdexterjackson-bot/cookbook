rules_version = '2';

// Milestone 2C, extended for #5 Groups & Friends. Covers every collection
// the app writes: entitlements, groups, groupCookbooks, memberships,
// joinRequests, invitations, friendRequests, friendships, publications
// (+ likes/ratings/comments), messages, groupCreationRequests,
// personalCookbooks.
//
// Design notes (why some things are stricter than they might look):
// - `memberships/{groupID}_{userID}` uses a deterministic composite ID
//   specifically so rules can check "is this user a member of this group"
//   with a single exists()/get() — rules can't run arbitrary queries.
// - `groups/{groupID}` create is tied, via getAfter(), to the matching
//   entitlements/{uid} document actually losing one tier2Credits in the
//   SAME transaction. This is what actually enforces "group creation costs
//   one tier-2 credit" — the entitlements update rule alone (decrement-by-1)
//   isn't sufficient on its own, since nothing would otherwise stop a client
//   from creating a group without touching entitlements at all.
// - `groupCookbooks/{cookbookID}` create has the same "founder acting
//   before their own membership/admin status exists yet" problem
//   memberships/create's founder branch solves — a brand-new group's first
//   cookbook is created in the same transaction as the group itself, so
//   isAdmin(groupID) can't be true yet. Resolved the same way: a getAfter()
//   check against the group doc's createdByUserID.
// - A public group's profile (groups/{id}) is readable once a member is
//   already able to reference its id, but a group's recipe content
//   (publications) is members-only regardless of visibility — the PRD is
//   explicit that "public" means discoverable-with-a-profile, not
//   "cookbook visible to non-members" (GRP-002). Cookbook visibility
//   within a group is all-or-nothing too: every member of a group sees
//   every one of its groupCookbooks, there's no per-cookbook membership.
// - `approvalPolicy` (on `groups/{id}`, replacing the old
//   `autoApproveJoinRequests` boolean) governs both whether joining needs
//   approval at all (`noApprovalNeeded` — same instant-membership path the
//   old boolean's `true` case used) and, for the other three policies, who
//   is allowed to decide a pending joinRequest (`creatorOnly` /
//   `anyAdministrator` / `anyUser`) — see canDecideJoinRequest() below.
//   This same helper gates both the joinRequests/update (decide) rule and
//   memberships/create's "someone approved my request" branch — those two
//   have to stay in lock-step, or a valid decide could produce a
//   membership write the decider isn't actually allowed to make.
// - `friendRequests/{senderID}_{recipientID}` and the paired
//   `friendships/{sortedID}` mirror groups/create's getAfter() pairing
//   pattern: a friendship can only be created alongside its matching
//   request doc actually flipping to 'accepted' in the same transaction.
// - Client-side entitlement increases are never allowed except two exact,
//   narrow shapes: the one-time launch-credit grant/backfill (validated to
//   an exact shape, gated by the promo cutoff date) and redeeming a tier-1
//   credit into isProUser (a paired transition — the credit already lives
//   on the user's own document, nothing external to verify, unlike a
//   StoreKit purchase). Everything else — actual purchases (Milestone 2D)
//   — is granted server-side via the Admin SDK, which bypasses these rules
//   entirely; the client is never trusted to grant itself credits any other
//   way.
// - `isMFB` (on groups/{id}) is the one hardcoded exception to the Pro User
//   join gate (memberships/create, joinRequests/create — see isProOrMFB).
//   It's never client-settable, by design — see FamilyGroup.isMFB's own
//   doc comment in the Swift model for why.
// - Rate limiting (SAFE-002) isn't enforceable from rules alone and isn't
//   attempted here; it needs a backend, which is a known gap for now.
//
// Not emulator-verified beyond what rules-tests/rules.test.js exercises —
// see that file for what's actually been proven against the real emulator
// versus reviewed by eye.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function membershipPath(groupID, userID) {
      return /databases/$(database)/documents/memberships/$(groupID + '_' + userID);
    }

    function isMember(groupID) {
      return isSignedIn()
        && exists(membershipPath(groupID, request.auth.uid))
        && get(membershipPath(groupID, request.auth.uid)).data.status == 'active';
    }

    function isAdmin(groupID) {
      return isSignedIn()
        && exists(membershipPath(groupID, request.auth.uid))
        && get(membershipPath(groupID, request.auth.uid)).data.status == 'active'
        && get(membershipPath(groupID, request.auth.uid)).data.role == 'admin';
    }

    // Tolerant of an entitlement doc written before a given credit tier
    // existed (the field is entirely absent, not just false/0) — treated
    // the same as "not yet received" / a zero balance, so the launch-time
    // backfill transition below can top it up correctly.
    function hasReceivedTier1(entitlementData) {
      return ('receivedTier1PromoCredit' in entitlementData) && entitlementData.receivedTier1PromoCredit == true;
    }
    function hasReceivedTier2(entitlementData) {
      return ('receivedTier2PromoCredits' in entitlementData) && entitlementData.receivedTier2PromoCredits == true;
    }
    function priorTier1Credits(entitlementData) {
      return ('tier1Credits' in entitlementData) ? entitlementData.tier1Credits : 0;
    }
    function priorTier2Credits(entitlementData) {
      return ('tier2Credits' in entitlementData) ? entitlementData.tier2Credits : 0;
    }
    function priorAnnualCredits(entitlementData) {
      return ('annualProMembershipCredits' in entitlementData) ? entitlementData.annualProMembershipCredits : 0;
    }
    function priorRedeemedDiscountCodes(entitlementData) {
      return ('redeemedDiscountCodes' in entitlementData) ? entitlementData.redeemedDiscountCodes : [];
    }
    // The six fields the Annual Pro Member sweep/webhook (Cloud Functions,
    // via the Admin SDK, which bypasses these rules entirely) writes —
    // never client-writable through any of the transitions below. Same
    // 'in'-guarded-default tolerance as the helpers above, using null as
    // the sentinel (works uniformly across the mixed String?/Timestamp?/
    // Bool? types here, unlike a type-specific default).
    function priorImagesRemovedAt(entitlementData) {
      return ('annualProMembershipImagesRemovedAt' in entitlementData) ? entitlementData.annualProMembershipImagesRemovedAt : null;
    }
    function priorOriginalTransactionID(entitlementData) {
      return ('annualProMembershipOriginalTransactionID' in entitlementData) ? entitlementData.annualProMembershipOriginalTransactionID : null;
    }
    function priorBillingRetryUntil(entitlementData) {
      return ('annualProMembershipBillingRetryUntil' in entitlementData) ? entitlementData.annualProMembershipBillingRetryUntil : null;
    }
    function priorWillRenew(entitlementData) {
      return ('annualProMembershipWillRenew' in entitlementData) ? entitlementData.annualProMembershipWillRenew : null;
    }
    function priorWarnedAtDay75(entitlementData) {
      return ('annualProMembershipWarnedAtDay75' in entitlementData) ? entitlementData.annualProMembershipWarnedAtDay75 : null;
    }
    function priorWarnedAtDay85(entitlementData) {
      return ('annualProMembershipWarnedAtDay85' in entitlementData) ? entitlementData.annualProMembershipWarnedAtDay85 : null;
    }
    // Bundles all six pins into one call so each update branch below reads
    // as one line instead of six repeated ones.
    function subscriptionServerFieldsUnchanged(before, after) {
      return priorImagesRemovedAt(after) == priorImagesRemovedAt(before)
        && priorOriginalTransactionID(after) == priorOriginalTransactionID(before)
        && priorBillingRetryUntil(after) == priorBillingRetryUntil(before)
        && priorWillRenew(after) == priorWillRenew(before)
        && priorWarnedAtDay75(after) == priorWarnedAtDay75(before)
        && priorWarnedAtDay85(after) == priorWarnedAtDay85(before);
    }
    // Tolerant "unchanged" comparison for a field that may be entirely
    // absent on either side (never-activated membership) — same "field
    // absent means a sentinel default" tolerance as the credit counts
    // above, just applied to an equality check instead of an increment.
    function annualExpiresAtOrEpoch(entitlementData) {
      return ('annualProMembershipExpiresAt' in entitlementData) ? entitlementData.annualProMembershipExpiresAt : timestamp.date(1970, 1, 1);
    }
    // Generic: works on either resource.data (the doc's prior state) or
    // request.resource.data (the write's resulting state) — both need the
    // same "field absent means false" tolerance, since a merge-style
    // backfill write can leave isProUser out of the payload entirely when
    // it was never set on the doc being merged onto.
    function isProUserFlag(entitlementData) {
      return ('isProUser' in entitlementData) && entitlementData.isProUser == true;
    }

    // Each free launch-promo tier is grantable to, and usable by, new
    // accounts only until its own date (must match
    // LaunchCreditPromo.tier1ExpirationDate/tier2ExpirationDate in
    // EntitlementGranting.swift exactly) — independent per tier, not one
    // shared cutoff.
    function tier1ExpirationTimestamp() {
      return timestamp.date(2027, 1, 1);
    }
    function tier2ExpirationTimestamp() {
      return timestamp.date(2029, 1, 1);
    }
    // Tolerant of a credit granted before this field existed (no
    // expiration recorded) — treated as not-expired, since going forward
    // every path that grants a tier credit also sets its matching
    // *ExpiresAt; this only matters for the narrow window before that
    // field shipped.
    function tier1NotExpired(entitlementData) {
      return !('tier1ExpiresAt' in entitlementData) || request.time < entitlementData.tier1ExpiresAt;
    }
    function tier2NotExpired(entitlementData) {
      return !('tier2ExpiresAt' in entitlementData) || request.time < entitlementData.tier2ExpiresAt;
    }
    // Must match DiscountCodePromo.redemptionDeadline in
    // DiscountCodePromo.swift exactly (valid through 2028-12-31).
    function discountCodeRedemptionDeadline() {
      return timestamp.date(2029, 1, 1);
    }

    // The Pro User paywall's join gate: MFB is the one cookbook exempt
    // from requiring Pro User status. isMFB is never client-settable (see
    // groups/create and groups/update below) — it's meant to be flipped
    // true directly in the console on the one seeded MFB document.
    function isProOrMFB(userID, groupID) {
      return (exists(/databases/$(database)/documents/entitlements/$(userID))
          && get(/databases/$(database)/documents/entitlements/$(userID)).data.isProUser == true)
        || (exists(/databases/$(database)/documents/groups/$(groupID))
          && get(/databases/$(database)/documents/groups/$(groupID)).data.isMFB == true);
    }

    function fetchGroup(groupID) {
      return get(/databases/$(database)/documents/groups/$(groupID)).data;
    }

    // Mirrors groups/{id}'s own "public or member" read rule — a public
    // group's cookbook *metadata* (name, cover, founder) is discoverable
    // the same way the group's own profile is, so public search can work
    // (see FEATURE 2's fetchPublicGroupCookbooks). This is metadata only:
    // a group's recipe *content* (publications) stays members-only
    // regardless of visibility (GRP-002) — that's a separate rule below,
    // unaffected by this.
    function isGroupPublic(groupID) {
      return fetchGroup(groupID).visibility == 'public';
    }

    // Who is allowed to decide (approve/deny) a pending joinRequest, per
    // the target group's approvalPolicy. Deliberately excludes
    // 'noApprovalNeeded' — that policy never produces a pending
    // joinRequest in the first place (memberships/create's 'auto' branch
    // handles it directly), so there's nothing for this to authorize.
    function creatorIsActiveMember(groupID) {
      let creatorID = fetchGroup(groupID).createdByUserID;
      return exists(membershipPath(groupID, creatorID))
        && get(membershipPath(groupID, creatorID)).data.status == 'active';
    }

    function canDecideJoinRequest(groupID) {
      return (fetchGroup(groupID).approvalPolicy == 'creatorOnly'
          && (
            (request.auth.uid == fetchGroup(groupID).createdByUserID && isMember(groupID))
            ||
            // Fallback once the creator is no longer an active member of
            // their own group (self-demoted and left) — otherwise a
            // creatorOnly group becomes permanently undecidable by anyone
            // actually still in it, while the departed creator would
            // retain sole, invisible decision power forever.
            (isAdmin(groupID) && !creatorIsActiveMember(groupID))
          ))
        || (fetchGroup(groupID).approvalPolicy == 'anyAdministrator' && isAdmin(groupID))
        || (fetchGroup(groupID).approvalPolicy == 'anyUser' && isMember(groupID));
    }

    function groupCookbookPath(cookbookID) {
      return /databases/$(database)/documents/groupCookbooks/$(cookbookID);
    }

    // FriendRequest doc IDs are direction-sensitive ({senderID}_{recipientID})
    // — this just centralizes building that path so both directions can be
    // checked without repeating the concatenation.
    function friendRequestPath(senderID, recipientID) {
      return /databases/$(database)/documents/friendRequests/$(senderID + '_' + recipientID);
    }

    function friendRequestRateLimitPath(userID) {
      return /databases/$(database)/documents/friendRequestRateLimits/$(userID);
    }

    // SAFE-002: sendFriendRequest is a direct client write (unlike
    // findUserByEmail, which goes through a rate-limited Cloud Function) —
    // this is what actually enforces a per-sender cap, since a sender's
    // UID is visible to every co-member of any group they're in. Requires
    // proof that a real, rule-validated increment to the sibling
    // friendRequestRateLimits/{senderID} doc happened in THIS SAME
    // transaction — comparing get() (pre-transaction) against getAfter()
    // (post-transaction) rather than just checking getAfter()'s value in
    // isolation, so a client can't send a doc referencing an old,
    // already-legitimate count without actually paying for a fresh
    // increment. The math itself (window/cap) is validated by
    // friendRequestRateLimits' own create/update rules below — this only
    // confirms that write actually happened and actually changed
    // something, not what it changed it to.
    function friendRequestRateLimitPaid(senderID) {
      let path = friendRequestRateLimitPath(senderID);
      return exists(path)
        ? (getAfter(path).data.windowStart != get(path).data.windowStart
            || getAfter(path).data.count > get(path).data.count)
        : getAfter(path).data.count == 1;
    }

    function sortedFriendshipID(userIDs) {
      return userIDs[0] < userIDs[1]
        ? userIDs[0] + '_' + userIDs[1]
        : userIDs[1] + '_' + userIDs[0];
    }

    match /entitlements/{userID} {
      allow read: if isSignedIn() && request.auth.uid == userID;

      // The one-time free-launch-credit grant — used the first time this
      // account is ever granted credits (see EntitlementGranting.swift).
      // Each tier's exact shape is branched independently since a brand
      // new account created after tier1's window closes but before
      // tier2's should still get tier2 (and vice versa) — not an
      // all-or-nothing "both tiers together" shape.
      allow create: if isSignedIn() && request.auth.uid == userID
        && request.resource.data.userID == userID
        && request.resource.data.isProUser == false
        // The launch-credit grant (the only thing that ever creates this
        // doc) never sets any of these three — an account only ever
        // acquires them later, via one of the update transitions below.
        && !('annualProMembershipCredits' in request.resource.data)
        && !('annualProMembershipExpiresAt' in request.resource.data)
        && !('redeemedDiscountCodes' in request.resource.data)
        && !('annualProMembershipImagesRemovedAt' in request.resource.data)
        && !('annualProMembershipOriginalTransactionID' in request.resource.data)
        && !('annualProMembershipBillingRetryUntil' in request.resource.data)
        && !('annualProMembershipWillRenew' in request.resource.data)
        && !('annualProMembershipWarnedAtDay75' in request.resource.data)
        && !('annualProMembershipWarnedAtDay85' in request.resource.data)
        && (
          (request.time < tier1ExpirationTimestamp()
            && request.resource.data.tier1Credits == 1
            && request.resource.data.receivedTier1PromoCredit == true)
          ||
          (request.time >= tier1ExpirationTimestamp()
            && request.resource.data.tier1Credits == 0
            && request.resource.data.receivedTier1PromoCredit == false)
        )
        && (
          (request.time < tier2ExpirationTimestamp()
            && request.resource.data.tier2Credits == 2
            && request.resource.data.receivedTier2PromoCredits == true)
          ||
          (request.time >= tier2ExpirationTimestamp()
            && request.resource.data.tier2Credits == 0
            && request.resource.data.receivedTier2PromoCredits == false)
        );

      // Exactly three client-writable transitions on an existing doc,
      // nothing else:
      allow update: if isSignedIn() && request.auth.uid == userID
        && request.resource.data.userID == resource.data.userID
        && (
          // Spending a tier-2 credit (group/Family Cookbook creation) —
          // exact decrement of 1, never below zero, nothing else moves.
          // Blocked once the credit has expired (tier2NotExpired) — the
          // client pre-checks this too for a clean error, but the rule is
          // the real enforcement against a client that skips the check.
          // Uses the same 'in'-guarded prior*/has* helpers the backfill
          // branch below already relied on — this whole || chain is
          // evaluated on every update, including a backfill of a
          // genuinely legacy doc that's missing these fields entirely, so
          // direct resource.data.tier2Credits-style access here would
          // throw (and, per the emulator, deny the whole update) before
          // ever reaching the branch that was actually meant to match.
          (request.resource.data.tier2Credits == priorTier2Credits(resource.data) - 1
            && request.resource.data.tier2Credits >= 0
            && tier2NotExpired(resource.data)
            && request.resource.data.tier1Credits == priorTier1Credits(resource.data)
            && isProUserFlag(request.resource.data) == isProUserFlag(resource.data)
            && request.resource.data.receivedTier1PromoCredit == hasReceivedTier1(resource.data)
            && request.resource.data.receivedTier2PromoCredits == hasReceivedTier2(resource.data)
            && priorAnnualCredits(request.resource.data) == priorAnnualCredits(resource.data)
            && annualExpiresAtOrEpoch(request.resource.data) == annualExpiresAtOrEpoch(resource.data)
            && priorRedeemedDiscountCodes(request.resource.data) == priorRedeemedDiscountCodes(resource.data)
            && subscriptionServerFieldsUnchanged(resource.data, request.resource.data))
          ||
          // Spending a tier-1 credit to become a Pro User — flips both
          // together, exactly once, nothing else moves. Same expiration
          // gate, and same guarded-helper reasoning, as tier2's spend
          // branch above.
          (isProUserFlag(resource.data) == false
            && request.resource.data.isProUser == true
            && request.resource.data.tier1Credits == priorTier1Credits(resource.data) - 1
            && request.resource.data.tier1Credits >= 0
            && tier1NotExpired(resource.data)
            && request.resource.data.tier2Credits == priorTier2Credits(resource.data)
            && request.resource.data.receivedTier1PromoCredit == hasReceivedTier1(resource.data)
            && request.resource.data.receivedTier2PromoCredits == hasReceivedTier2(resource.data)
            && priorAnnualCredits(request.resource.data) == priorAnnualCredits(resource.data)
            && annualExpiresAtOrEpoch(request.resource.data) == annualExpiresAtOrEpoch(resource.data)
            && priorRedeemedDiscountCodes(request.resource.data) == priorRedeemedDiscountCodes(resource.data)
            && subscriptionServerFieldsUnchanged(resource.data, request.resource.data))
          ||
          // Backfilling a free launch credit this account hasn't received
          // yet (an entitlement doc that predates one/both tiers, possibly
          // missing the field entirely — see hasReceivedTier1/2 above).
          // Each tier independently either (a) grants, while still within
          // its own expiration window, (b) stays untouched because it was
          // already received, or (c) stays untouched because its window
          // has passed and it was never received (a genuine no-grant, not
          // a rejection) — at least one tier must actually change;
          // isProUser never moves here.
          (isProUserFlag(request.resource.data) == isProUserFlag(resource.data)
            && (
              (!hasReceivedTier1(resource.data)
                && request.time < tier1ExpirationTimestamp()
                && request.resource.data.receivedTier1PromoCredit == true
                && request.resource.data.tier1Credits == priorTier1Credits(resource.data) + 1)
              ||
              (hasReceivedTier1(resource.data)
                && request.resource.data.receivedTier1PromoCredit == true
                && request.resource.data.tier1Credits == priorTier1Credits(resource.data))
              ||
              (!hasReceivedTier1(resource.data)
                && request.time >= tier1ExpirationTimestamp()
                && request.resource.data.receivedTier1PromoCredit == false
                && request.resource.data.tier1Credits == priorTier1Credits(resource.data))
            )
            && (
              (!hasReceivedTier2(resource.data)
                && request.time < tier2ExpirationTimestamp()
                && request.resource.data.receivedTier2PromoCredits == true
                && request.resource.data.tier2Credits == priorTier2Credits(resource.data) + 2)
              ||
              (hasReceivedTier2(resource.data)
                && request.resource.data.receivedTier2PromoCredits == true
                && request.resource.data.tier2Credits == priorTier2Credits(resource.data))
              ||
              (!hasReceivedTier2(resource.data)
                && request.time >= tier2ExpirationTimestamp()
                && request.resource.data.receivedTier2PromoCredits == false
                && request.resource.data.tier2Credits == priorTier2Credits(resource.data))
            )
            && (!hasReceivedTier1(resource.data) || !hasReceivedTier2(resource.data))
            && priorAnnualCredits(request.resource.data) == priorAnnualCredits(resource.data)
            && annualExpiresAtOrEpoch(request.resource.data) == annualExpiresAtOrEpoch(resource.data)
            && priorRedeemedDiscountCodes(request.resource.data) == priorRedeemedDiscountCodes(resource.data)
            && subscriptionServerFieldsUnchanged(resource.data, request.resource.data)
          )
          ||
          // Spending an Annual Pro Membership credit — decrements by 1,
          // sets the active expiration to roughly one year out. Bounded
          // rather than checked for exact equality to "request.time + 365
          // days": request.time is the server's own commit timestamp, not
          // whatever instant the client computed locally when it built the
          // write, so an exact-equality check would fail on ordinary
          // clock/network latency skew. Accepts anything strictly after
          // now and no more than ~370 days out (370, not 365, for a leap
          // year plus slack) instead.
          (request.resource.data.annualProMembershipCredits == priorAnnualCredits(resource.data) - 1
            && request.resource.data.annualProMembershipCredits >= 0
            && request.resource.data.annualProMembershipExpiresAt > request.time
            && request.resource.data.annualProMembershipExpiresAt <= request.time + duration.value(370, 'd')
            && priorRedeemedDiscountCodes(request.resource.data) == priorRedeemedDiscountCodes(resource.data)
            && request.resource.data.tier1Credits == priorTier1Credits(resource.data)
            && request.resource.data.tier2Credits == priorTier2Credits(resource.data)
            && isProUserFlag(request.resource.data) == isProUserFlag(resource.data)
            && request.resource.data.receivedTier1PromoCredit == hasReceivedTier1(resource.data)
            && request.resource.data.receivedTier2PromoCredits == hasReceivedTier2(resource.data)
            && subscriptionServerFieldsUnchanged(resource.data, request.resource.data))
          ||
          // Redeeming the one active discount code for one Annual Pro
          // Membership credit. The code and its deadline are enforced
          // here, not just client-side (DiscountCodePromo.swift) — this
          // grants a real credit, so a compromised client must not be able
          // to fabricate a code string or backdate the deadline. One
          // hardcoded code today; a second would just be another || arm
          // here, not a lookup table nobody's asked for yet.
          (request.resource.data.redeemedDiscountCodes == priorRedeemedDiscountCodes(resource.data).concat(['7595SLEDGERD'])
            && !('7595SLEDGERD' in priorRedeemedDiscountCodes(resource.data))
            && request.time < discountCodeRedemptionDeadline()
            && request.resource.data.annualProMembershipCredits == priorAnnualCredits(resource.data) + 1
            && annualExpiresAtOrEpoch(request.resource.data) == annualExpiresAtOrEpoch(resource.data)
            && request.resource.data.tier1Credits == priorTier1Credits(resource.data)
            && request.resource.data.tier2Credits == priorTier2Credits(resource.data)
            && isProUserFlag(request.resource.data) == isProUserFlag(resource.data)
            && request.resource.data.receivedTier1PromoCredit == hasReceivedTier1(resource.data)
            && request.resource.data.receivedTier2PromoCredits == hasReceivedTier2(resource.data)
            && subscriptionServerFieldsUnchanged(resource.data, request.resource.data))
        );

      allow delete: if false;
    }

    match /groups/{groupID} {
      allow read: if resource.data.visibility == 'public' || isMember(groupID);

      allow create: if isSignedIn()
        && request.auth.uid == request.resource.data.createdByUserID
        && request.resource.data.status == 'active'
        && request.resource.data.visibility in ['public', 'private']
        && request.resource.data.approvalPolicy in ['creatorOnly', 'anyAdministrator', 'anyUser', 'noApprovalNeeded']
        // Never client-settable — see isMFB's doc comment on FamilyGroup.
        && request.resource.data.isMFB == false
        && get(/databases/$(database)/documents/entitlements/$(request.auth.uid)).data.tier2Credits
           - getAfter(/databases/$(database)/documents/entitlements/$(request.auth.uid)).data.tier2Credits == 1;

      allow update: if isAdmin(groupID)
        && request.resource.data.createdByUserID == resource.data.createdByUserID
        && request.resource.data.id == resource.data.id
        && request.resource.data.isMFB == resource.data.isMFB
        && request.resource.data.approvalPolicy in ['creatorOnly', 'anyAdministrator', 'anyUser', 'noApprovalNeeded'];

      allow delete: if false;
    }

    // A group's cookbooks — split out from groups/{id} itself (see
    // GroupCookbook's own doc comment in the Swift model) since one group
    // can now hold several. Visibility is all-or-nothing per group
    // membership, not per cookbook: every active member of the parent
    // group can read every one of its cookbooks.
    match /groupCookbooks/{cookbookID} {
      allow read: if isGroupPublic(resource.data.groupID) || isMember(resource.data.groupID);

      allow create: if isSignedIn()
        && request.auth.uid == request.resource.data.createdByUserID
        && (
          isAdmin(request.resource.data.groupID)
          ||
          // The founder creating the group's very first cookbook in the
          // same transaction as the group itself — see the founder-branch
          // design note at the top of this file. Self-limiting the same
          // way memberships/create's own founder branch is: gated on the
          // founder's membership doc not existing yet in the PRE-batch
          // state (get(), not getAfter()) — true only during the actual
          // founding write, and permanently false afterward since that
          // membership doc is created in the same batch and never
          // deleted (only soft-left). Without this, a founder who later
          // demotes themselves and leaves could still call this branch
          // forever, since createdByUserID never changes.
          (getAfter(/databases/$(database)/documents/groups/$(request.resource.data.groupID)).data.createdByUserID == request.auth.uid
            && !exists(/databases/$(database)/documents/memberships/$(request.resource.data.groupID + '_' + request.auth.uid)))
        );

      // Admin-only, and can't be reparented to a different group.
      allow update: if isAdmin(resource.data.groupID)
        && request.resource.data.groupID == resource.data.groupID;

      allow delete: if false;
    }

    match /memberships/{membershipID} {
      allow read: if isSignedIn()
        && (request.auth.uid == resource.data.userID || isMember(resource.data.groupID));

      allow create: if isSignedIn()
        && membershipID == request.resource.data.groupID + '_' + request.resource.data.userID
        && (
          // Founding admin, created atomically with the group itself.
          (request.auth.uid == request.resource.data.userID
            && request.resource.data.source == 'founder'
            && request.resource.data.role == 'admin'
            && getAfter(/databases/$(database)/documents/groups/$(request.resource.data.groupID)).data.createdByUserID == request.auth.uid)
          ||
          // Someone with standing to decide join requests for this group
          // (admin, or — per approvalPolicy — the creator or any member)
          // approving someone else's request. The requester must already
          // be Pro (or MFB) — normally already guaranteed by
          // joinRequests/create below, this is defense-in-depth for a
          // decider approving a request that's gone stale since it was
          // filed. Uses the same canDecideJoinRequest() the joinRequests
          // update rule uses — these two must stay in lock-step, since a
          // valid decide is worthless if it can't be followed by the
          // matching membership write.
          (canDecideJoinRequest(request.resource.data.groupID)
            && request.resource.data.source == 'request'
            && request.resource.data.role == 'member'
            && request.auth.uid != request.resource.data.userID
            && isProOrMFB(request.resource.data.userID, request.resource.data.groupID))
          ||
          // The invitee accepting their own invitation.
          (request.auth.uid == request.resource.data.userID
            && request.resource.data.source == 'invite'
            && isProOrMFB(request.resource.data.userID, request.resource.data.groupID))
          ||
          // Auto-approve: the requester joins directly as a plain member
          // when the target group's approvalPolicy is noApprovalNeeded
          // (e.g. a global seed cookbook everyone's invited to) —
          // independently re-checked against the stored group doc, never
          // trusted from the client alone.
          (request.auth.uid == request.resource.data.userID
            && request.resource.data.source == 'auto'
            && request.resource.data.role == 'member'
            && fetchGroup(request.resource.data.groupID).approvalPolicy == 'noApprovalNeeded'
            && isProOrMFB(request.resource.data.userID, request.resource.data.groupID))
        );

      allow update: if isSignedIn()
        && resource.data.groupID == request.resource.data.groupID
        && resource.data.userID == request.resource.data.userID
        && (
          // Leaving, on one's own — only a plain member. An active admin
          // must go through the changeOwnMembership callable instead
          // (functions/changeOwnMembership.js), which re-verifies
          // server-side that another admin remains before allowing it —
          // rules alone can't count active admins across a collection to
          // enforce "the last admin can't leave."
          (request.auth.uid == resource.data.userID
            && request.resource.data.status == 'left'
            && resource.data.role == 'member')
          ||
          // An admin promoting/demoting/removing *someone else* is
          // deliberately NOT a direct write here — it goes through the
          // changeMemberRole callable (functions/changeMemberRole.js)
          // instead. A single write in isolation looks safe (the acting
          // admin stays admin, so the group never drops to zero admins on
          // its own), but two admins simultaneously demoting/removing
          // *each other* both read "2 admins, safe" and both commit,
          // zeroing the group's admin count with no way to ever create
          // another. Rules can't re-count active admins across a
          // collection to close that race, and neither can a client-side
          // Firestore transaction (its Transaction type has no query
          // support) — only the Admin SDK's transactional query can.
          //
          // Reactivating a previously left/suspended membership doc.
          // Membership.compositeID's own doc comment says status
          // transitions are meant to reuse the same document rather than
          // pile up duplicates — but a rejoin write lands on a doc that
          // already exists, so it's an `update` to Firestore, not a
          // `create`, and none of memberships/create's three self-service
          // branches (decider approval / invite accept / auto-approve)
          // would ever apply here. Mirrors those same three branches
          // (everything except the one-shot founder branch, which by
          // definition can't apply to a rejoin) so leaving/being removed
          // was never a permanent dead end.
          (resource.data.status in ['left', 'suspended']
            && request.resource.data.status == 'active'
            && (
              (canDecideJoinRequest(resource.data.groupID)
                && request.resource.data.source == 'request'
                && request.resource.data.role == 'member'
                && request.auth.uid != resource.data.userID
                && isProOrMFB(resource.data.userID, resource.data.groupID))
              ||
              (request.auth.uid == resource.data.userID
                && request.resource.data.source == 'invite'
                && isProOrMFB(resource.data.userID, resource.data.groupID))
              ||
              (request.auth.uid == resource.data.userID
                && request.resource.data.source == 'auto'
                && request.resource.data.role == 'member'
                && fetchGroup(resource.data.groupID).approvalPolicy == 'noApprovalNeeded'
                && isProOrMFB(resource.data.userID, resource.data.groupID))
            ))
        );

      allow delete: if false;
    }

    match /joinRequests/{requestID} {
      allow read: if isSignedIn()
        && (request.auth.uid == resource.data.requesterID || isAdmin(resource.data.groupID));

      allow create: if isSignedIn()
        && request.auth.uid == request.resource.data.requesterID
        && request.resource.data.state == 'pending'
        && !isMember(request.resource.data.groupID)
        && isProOrMFB(request.resource.data.requesterID, request.resource.data.groupID);

      allow update: if isSignedIn()
        && resource.data.state == 'pending'
        && request.resource.data.state in ['approved', 'denied']
        && request.resource.data.decidedByUserID == request.auth.uid
        && request.resource.data.requesterID == resource.data.requesterID
        && request.resource.data.groupID == resource.data.groupID
        && canDecideJoinRequest(resource.data.groupID);

      allow delete: if false;
    }

    match /invitations/{invitationID} {
      // request.auth.uid == inviteeIdentifier covers a UID-based invite
      // (friend invites); the email check covers the original
      // email-based flow — kept both since inviteeIdentifier can hold
      // either shape depending on how the invite was sent.
      allow read: if isSignedIn()
        && (request.auth.uid == resource.data.inviterID
          || isAdmin(resource.data.groupID)
          || request.auth.token.email == resource.data.inviteeIdentifier
          || request.auth.uid == resource.data.inviteeIdentifier);

      allow create: if isSignedIn()
        && request.auth.uid == request.resource.data.inviterID
        && request.resource.data.state == 'pending'
        && (isAdmin(request.resource.data.groupID)
          || (isMember(request.resource.data.groupID)
            && get(/databases/$(database)/documents/groups/$(request.resource.data.groupID)).data.allowsMemberInvites == true));

      allow update: if isSignedIn()
        && resource.data.state == 'pending'
        && resource.data.groupID == request.resource.data.groupID
        && resource.data.inviterID == request.resource.data.inviterID
        && resource.data.inviteeIdentifier == request.resource.data.inviteeIdentifier
        && (
          ((request.auth.token.email == resource.data.inviteeIdentifier
              || request.auth.uid == resource.data.inviteeIdentifier)
            && request.resource.data.state in ['accepted', 'declined'])
          ||
          ((request.auth.uid == resource.data.inviterID || isAdmin(resource.data.groupID))
            && request.resource.data.state == 'revoked')
        );

      allow delete: if false;
    }

    // Sibling to friendRequests below — see friendRequestRateLimitPaid()'s
    // doc comment for why this collection exists at all. windowMs (1 hour)
    // and maxAttempts (20) match findUserByEmailAttempts' own budget.
    match /friendRequestRateLimits/{userID} {
      allow read: if isSignedIn() && request.auth.uid == userID;

      allow create: if isSignedIn()
        && request.auth.uid == userID
        && request.resource.data.windowStart == request.time
        && request.resource.data.count == 1;

      allow update: if isSignedIn()
        && request.auth.uid == userID
        && (
          // Window (1hr = 3600000ms) expired — reset.
          (request.time.toMillis() - resource.data.windowStart.toMillis() > 3600000
            && request.resource.data.windowStart == request.time
            && request.resource.data.count == 1)
          ||
          // Still inside the window — increment, capped at 20.
          (request.time.toMillis() - resource.data.windowStart.toMillis() <= 3600000
            && resource.data.count < 20
            && request.resource.data.windowStart == resource.data.windowStart
            && request.resource.data.count == resource.data.count + 1)
        );

      allow delete: if false;
    }

    match /friendRequests/{requestID} {
      allow read: if isSignedIn()
        && (request.auth.uid == resource.data.senderID || request.auth.uid == resource.data.recipientID);

      allow create: if isSignedIn()
        && request.auth.uid == request.resource.data.senderID
        && request.resource.data.senderID != request.resource.data.recipientID
        && requestID == request.resource.data.senderID + '_' + request.resource.data.recipientID
        && request.resource.data.status == 'pending'
        && friendRequestRateLimitPaid(request.resource.data.senderID);

      allow update: if isSignedIn()
        && resource.data.senderID == request.resource.data.senderID
        && resource.data.recipientID == request.resource.data.recipientID
        && (
          // The recipient accepting or declining a pending request.
          (request.auth.uid == resource.data.recipientID
            && resource.data.status == 'pending'
            && request.resource.data.status in ['accepted', 'declined'])
          ||
          // The original sender withdrawing their own pending request —
          // quiet, no-further-action, same shape as a decline but
          // distinguishable in the doc's own history (see
          // FriendRequestStatus.cancelled's doc comment).
          (request.auth.uid == resource.data.senderID
            && resource.data.status == 'pending'
            && request.resource.data.status == 'cancelled')
          ||
          // The original sender re-requesting after an earlier decline or
          // a cancel — same doc ID (senderID_recipientID), reset back to
          // pending rather than erroring on "already exists." The other
          // direction (the original recipient choosing to send their own
          // request) is a different doc ID and just goes through create
          // instead.
          (request.auth.uid == resource.data.senderID
            && resource.data.status in ['declined', 'cancelled']
            && request.resource.data.status == 'pending'
            && friendRequestRateLimitPaid(resource.data.senderID))
        );

      allow delete: if false;
    }

    match /friendships/{friendshipID} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.userIDs;

      // Paired with an accepted friendRequests doc in the same
      // transaction (mirrors groups/create's uniqueness-reservation
      // pairing) — checks both possible request directions, since either
      // party could have been the original sender.
      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.userIDs
        && request.resource.data.userIDs.size() == 2
        && request.resource.data.userIDs[0] != request.resource.data.userIDs[1]
        && friendshipID == sortedFriendshipID(request.resource.data.userIDs)
        && (
          getAfter(friendRequestPath(request.resource.data.userIDs[0], request.resource.data.userIDs[1])).data.status == 'accepted'
          ||
          getAfter(friendRequestPath(request.resource.data.userIDs[1], request.resource.data.userIDs[0])).data.status == 'accepted'
        );

      allow update: if false;
      allow delete: if isSignedIn() && request.auth.uid in resource.data.userIDs;
    }

    match /publications/{publicationID} {
      // Members-only regardless of the group's visibility (GRP-002) — a
      // public group's profile is discoverable, its recipes are not.
      allow read: if isMember(resource.data.groupID);

      allow create: if isSignedIn()
        && request.auth.uid == request.resource.data.ownerUserID
        && request.resource.data.state == 'published'
        // Prevents forging a publication that points at a cookbookID from
        // a different group than the one it claims to belong to.
        && get(groupCookbookPath(request.resource.data.cookbookID)).data.groupID == request.resource.data.groupID
        && (isAdmin(request.resource.data.groupID)
          || (isMember(request.resource.data.groupID)
            && get(groupCookbookPath(request.resource.data.cookbookID)).data.allowsMemberPublishing == true));

      allow update: if isSignedIn()
        && resource.data.groupID == request.resource.data.groupID
        && resource.data.ownerUserID == request.resource.data.ownerUserID
        && resource.data.sourceRecipeID == request.resource.data.sourceRecipeID
        && (
          // The owner republishing/unpublishing their own recipe.
          (request.auth.uid == resource.data.ownerUserID
            && request.resource.data.state in ['published', 'unpublished'])
          ||
          // An admin hiding it pending review (SAFE-003) — content is
          // untouched; ownership/authorship never transfers to the admin.
          (isAdmin(resource.data.groupID)
            && request.resource.data.state == 'hidden'
            && request.resource.data.content == resource.data.content)
          ||
          // Any member liking/unliking or rating/re-rating/clearing —
          // state and content are pinned equal so this can only ever
          // touch aggregate fields (likeCount, ratingSum, ratingCount),
          // not sneak in a content or visibility change. This branch
          // doesn't name which non-pinned field moves, so it already
          // covers both counters without a separate branch — the exact
          // math is trusted to the client's own transaction
          // (PublicationsServicing.setLiked/setRating/clearRating) rather
          // than re-verified here; neither a "like" nor a "rating" is
          // money/credits, so this doesn't need the same getAfter()-paired
          // rigor as entitlements/groups.
          (isMember(resource.data.groupID)
            && request.resource.data.state == resource.data.state
            && request.resource.data.content == resource.data.content)
        );

      // New, was unconditionally false: the owner removing their own
      // recipe, or an admin removing anyone's — same owner-or-admin shape
      // as the comments delete rule below.
      allow delete: if isSignedIn()
        && (request.auth.uid == resource.data.ownerUserID || isAdmin(resource.data.groupID));
    }

    // A publication's comments — gated on the parent publication's own
    // commentsEnabled flag at create time, not a per-comment isHidden
    // field (there isn't one; the whole list is hidden together when
    // comments are off). Otherwise immutable once posted.
    match /publications/{publicationID}/comments/{commentID} {
      allow read: if isMember(resource.data.groupID);

      allow create: if isSignedIn()
        && isMember(request.resource.data.groupID)
        && request.auth.uid == request.resource.data.authorUserID
        && get(/databases/$(database)/documents/publications/$(publicationID)).data.commentsEnabled == true;

      // The one exception to "immutable": a comment's own author
      // rewriting their own displayed name on it — everything else is
      // pinned equal. This is what tombstoneCommentAuthorship uses on
      // account deletion (PublicationsServicing) so a deleted user's
      // comments read as "Deleted User" rather than staying attributed
      // to an account that no longer exists, same reasoning as
      // publications' own tombstoneOwnerAttribution.
      allow update: if isSignedIn()
        && request.auth.uid == resource.data.authorUserID
        && request.resource.data.authorUserID == resource.data.authorUserID
        && request.resource.data.publicationID == resource.data.publicationID
        && request.resource.data.groupID == resource.data.groupID
        && request.resource.data.text == resource.data.text
        && request.resource.data.createdAt == resource.data.createdAt;

      // Owner-or-admin, same shape as publication delete above — the
      // minimum moderation capability a group needs from day one, not
      // full moderation tooling.
      allow delete: if isSignedIn()
        && (request.auth.uid == resource.data.authorUserID || isAdmin(resource.data.groupID));
    }

    // One doc per user who's liked a publication — existence is the
    // signal (not a count), so PublicationsServicing.hasLiked/setLiked can
    // tell "have I already liked this" without scanning anything, and the
    // paired publications/{id}.likeCount update above stays idempotent
    // per user (liking twice never double-counts).
    match /publications/{publicationID}/likes/{userID} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userID;
      allow update: if false;
      allow delete: if isSignedIn() && request.auth.uid == userID;
    }

    // One doc per user who's rated a publication, holding their own 1-5
    // value — unlike likes, a rating can be *changed* in place (not just
    // toggled on/off), so this deliberately allows update, matching
    // PublicationsServicing.setRating's upsert semantics.
    match /publications/{publicationID}/ratings/{userID} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && request.auth.uid == userID
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1 && request.resource.data.rating <= 5;
      allow delete: if isSignedIn() && request.auth.uid == userID;
    }

    match /messages/{messageID} {
      allow read: if isSignedIn() && request.auth.uid == resource.data.recipientID;

      allow create: if isSignedIn() && request.auth.uid == request.resource.data.senderID;

      // Only the recipient marking read/actioned; identity fields immutable.
      allow update: if isSignedIn()
        && request.auth.uid == resource.data.recipientID
        && resource.data.recipientID == request.resource.data.recipientID
        && resource.data.senderID == request.resource.data.senderID
        && resource.data.type == request.resource.data.type
        && resource.data.payloadReference == request.resource.data.payloadReference;

      allow delete: if false;
    }

    // PAY-005's idempotency ledger for createGroup. The real protection
    // against double-charging is the groups/create rule's getAfter() check
    // above; this collection mainly needs to stay immutable once written.
    match /groupCreationRequests/{idempotencyKey} {
      allow read: if isSignedIn() && request.auth.uid == resource.data.requestedByUserID;
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.requestedByUserID;
      allow update: if false;
      allow delete: if false;
    }

    // Milestone 2D: the client submits a signed StoreKit transaction here
    // after a locally-verified purchase; it is otherwise inert from the
    // client's point of view — only the purchaseClaims Cloud Function
    // (Admin SDK, bypasses these rules) re-verifies the JWS against Apple
    // and grants the matching entitlements/{uid} update. A client can
    // never mark its own claim processed or edit it after the fact.
    match /purchaseClaims/{claimID} {
      allow read: if isSignedIn() && request.auth.uid == resource.data.userID;
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.userID;
      allow update: if false;
      allow delete: if false;
    }

    // A user's own optional profile data (currently just Location) — Full
    // Name lives on Firebase Auth's displayName instead, since Auth
    // doesn't support arbitrary custom fields. Nothing here is
    // security-sensitive, so unlike group deletion this doesn't need a
    // Cloud Function — the owner manages their own doc directly.
    match /userProfiles/{userID} {
      allow read, write, delete: if isSignedIn() && request.auth.uid == userID;
    }

    // Personal Cookbook Cloud Sync (opt-in per cookbook, manual "push on
    // Back Up" — see CookbookConfigurationView's Sync to Cloud toggle).
    // Strictly single-owner data, no group/sharing concept involved, so
    // both this and the recipes subcollection below check `ownerUserID`
    // directly on the resource rather than doing a cross-collection
    // membership-style lookup the way groups/publications need to.
    match /personalCookbooks/{cookbookID} {
      allow read: if isSignedIn() && request.auth.uid == resource.data.ownerUserID;
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.ownerUserID;
      allow update: if isSignedIn()
        && request.auth.uid == resource.data.ownerUserID
        && request.auth.uid == request.resource.data.ownerUserID;
      allow delete: if isSignedIn() && request.auth.uid == resource.data.ownerUserID;

      // ownerUserID is duplicated onto every recipe doc specifically so
      // this can check it directly, cheaper than a get() on the parent
      // cookbook doc for every recipe read/write.
      match /recipes/{recipeID} {
        allow read: if isSignedIn() && request.auth.uid == resource.data.ownerUserID;
        allow create: if isSignedIn() && request.auth.uid == request.resource.data.ownerUserID;
        allow update: if isSignedIn()
          && request.auth.uid == resource.data.ownerUserID
          && request.auth.uid == request.resource.data.ownerUserID;
        allow delete: if isSignedIn() && request.auth.uid == resource.data.ownerUserID;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
